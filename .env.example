# HTTP server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Trello API credentials
TRELLO_KEY=replace-me
TRELLO_TOKEN=replace-me

# Public URL Trello calls. This exact URL is used for webhook signature checks.
TRELLO_CALLBACK_URL=https://example.com/webhooks/trello

# Trello webhook signing secret. Usually the same value as the OAuth token secret
# for OAuth flows. Leave empty to skip signature validation for local testing only.
TRELLO_WEBHOOK_SECRET=

# Board or list model to register the webhook against.
TRELLO_BOARD_ID=replace-me

# Workflow lists.
TRELLO_TODO_LIST_ID=replace-me
TRELLO_QUESTION_LIST_ID=
TRELLO_REVIEW_LIST_ID=replace-me
TRELLO_DONE_LIST_ID=replace-me

# Optional Trello label IDs for automation status.
TRELLO_RUNNING_LABEL_ID=
TRELLO_QUESTION_LABEL_ID=
TRELLO_REVIEW_LABEL_ID=
TRELLO_DONE_LABEL_ID=
TRELLO_FAILED_LABEL_ID=

# Optional gate: when set, only cards with at least one of these label IDs start Codex.
# Leave empty to allow any card in the To Do list.
TRELLO_START_LABEL_IDS=

# Local repository that Codex should modify.
TARGET_REPO=/absolute/path/to/repo
REPO_ALLOWLIST=/absolute/path/to/repo
BASE_BRANCH=main
REMOTE_NAME=origin

# Folder where per-card git worktrees are created.
WORKTREE_ROOT=/absolute/path/to/codex-worktrees

# Command template run inside each worktree. Available placeholders:
# {prompt_file}, {workdir}, {branch}, {card_id}, {card_url}, {card_name}
#
# Example for a Codex CLI installation:
# CODEX_COMMAND_TEMPLATE=codex exec --cd {workdir} --full-auto --input-file {prompt_file}
CODEX_COMMAND_TEMPLATE=codex exec --cd {workdir} --full-auto --input-file {prompt_file}
CODEX_TIMEOUT_SECONDS=7200
MAX_CONCURRENT_JOBS=1
DRY_RUN=false

# Product card sections required before Codex starts.
REQUIRED_CARD_SECTIONS=Problem,Scope,Acceptance Criteria,Test Plan

# Optional GitHub PR creation.
ENABLE_GIT_PUSH=false
ENABLE_PR_CREATION=false
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_API_URL=https://api.github.com
PR_BASE_BRANCH=main

# SQLite state and durable job queue.
STATE_FILE=.taskforge-state.sqlite3
JOB_POLL_INTERVAL_SECONDS=1.0
CLEANUP_STATUSES=done
